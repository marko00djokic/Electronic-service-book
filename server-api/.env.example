# MySQL konekcija (cPanel → MySQL Databases)
DB_HOST=localhost
DB_USER=kafanicars_esb
DB_PASS=your_password_here
DB_NAME=kafanicars_esb

# JWT tajni ključ — generiši sa: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# API ključ za desktop app autentifikaciju pri sync-u
# Hash se generiše sa: node -e "const b=require('bcryptjs');b.hash('your_key',10).then(h=>console.log(h))"
# U .env ide PLAIN TEXT ključ — hash se čuva u bazi tabela api_keys
API_KEY=change_this_to_a_strong_random_key

# Express port (Passenger ga ignoriše — koristi sopstveni port)
PORT=3000

NODE_ENV=production

# CORS — dozvoli web portal domenu (ostavi * za razvoj)
CORS_ORIGIN=https://kafanica-sa-dobrom-klopom.rs
